{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Review Pack Catalog Health Diagnostics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "summary", "findings", "warnings", "canonicality", "load_source"],
  "properties": {
    "schema_version": { "const": "catalog_health_diagnostics.v1" },
    "review_id": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_status",
        "finding_count",
        "counts_by_status",
        "counts_by_category",
        "counts_by_scope",
        "selected_catalog_id",
        "selected_run_id"
      ],
      "properties": {
        "overall_status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
        "finding_count": { "type": "integer", "minimum": 0 },
        "counts_by_status": { "type": "object" },
        "counts_by_category": { "type": "object" },
        "counts_by_scope": { "type": "object" },
        "selected_catalog_id": { "type": ["string", "null"] },
        "selected_run_id": { "type": ["string", "null"] }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "canonicality": { "$ref": "#/$defs/canonicality" },
    "load_source": { "$ref": "#/$defs/loadSource" }
  },
  "$defs": {
    "canonicality": {
      "type": "object",
      "required": ["schema_version", "derived_class", "non_authoritative", "write_back_forbidden", "rebuildable"],
      "properties": {
        "schema_version": { "const": "canonicality.v1" },
        "derived_class": { "const": "review_pack" },
        "non_authoritative": { "const": true },
        "write_back_forbidden": { "const": true },
        "rebuildable": { "const": true }
      }
    },
    "loadSource": {
      "type": "object",
      "required": ["schema_version", "loaded_from", "canonical_source", "non_authoritative"],
      "properties": {
        "schema_version": { "const": "load_source.v1" },
        "loaded_from": { "const": "review_pack" },
        "canonical_source": { "const": "artifacts" },
        "non_authoritative": { "const": true }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "check_id",
        "severity",
        "status",
        "scope",
        "category",
        "message",
        "paths"
      ],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "check_id": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "NA"] },
        "status": { "type": "string", "enum": ["PASS", "WARN", "FAIL", "NA"] },
        "scope": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "remediation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
